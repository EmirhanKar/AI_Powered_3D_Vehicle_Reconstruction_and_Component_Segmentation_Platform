# ==============================================================================
# ModifAI 3D Servisi (3Dservice) — Örnek Ortam Değişkenleri (.env.example)
# Bu dosyayı .env olarak kopyalayıp kendi ortamınıza göre düzenleyin.
# ==============================================================================

# ── 1. API Sunucu ve Güvenlik Ayarları ──
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
# Backend ile aynı X-Admin-Key doğrulaması için kullanılan gizli anahtar
API_KEY=ABCDEFGHIJKLMNOPRSTUVYZ123

# ── 2. Mevcut Backend Entegrasyonu ve Poller Ayarları ──
# Ana FastAPI Backend adresi (Backend poller ve sonuç yükleme için)
BACKEND_URL=http://localhost:8000
# Tekil iş bittiğinde çağrılacak opsiyonel webhook URL'si (boş bırakılabilir)
BACKEND_CALLBACK_URL=
# Backend'in /scans/pending_3d kuyruğunu otomatik tarama modu (true/false)
ENABLE_BACKEND_POLLER=true
POLL_INTERVAL_SECONDS=5
BACKEND_MAX_RETRIES=3

# ── 3. Dizin, Depolama ve Eşzamanlılık ──
JOBS_DIR=./jobs
OUTPUTS_DIR=./outputs
# Depolama tipi: "local" veya "s3"
STORAGE_BACKEND=local
S3_BUCKET_NAME=modifai-3d-artifacts
S3_REGION=eu-central-1
S3_ENDPOINT_URL=
# GPU VRAM darboğazını önlemek için aynı anda çalışacak maksimum iş sayısı
MAX_CONCURRENT_JOBS=1
STEP_TIMEOUT_SECONDS=1800

# ── 4. Adım 00: Girdi Doğrulama (Validate Input) Eikleri ──
MAX_VIDEO_MB=500
MAX_VIDEO_SECONDS=180
MIN_VIDEO_SECONDS=3
MIN_VIDEO_WIDTH=640
MIN_VIDEO_HEIGHT=480
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ── 5. Adım 01: Kare Çıkarma ve Anahtar Kare Seçimi (Extract Frames) ──
TARGET_FRAME_COUNT=80
MIN_FRAME_COUNT=24
# Laplacian varyansı bu değerin altındaysa kare bulanık kabul edilip elenir
BLUR_THRESHOLD=80.0
# Ardışık kareler arasındaki minimum optik akış / paralaks skoru
MIN_PARALLAX_SCORE=2.5

# ── 6. Adım 02: 360° Video Yeniden İzdüşümü (Reproject 360) ──
# Her bir 360° equirectangular kareden üretilecek sanal perspektif kamera sayısı
VIRTUAL_VIEW_COUNT=6
# Sanal perspektif kameraların görüş açısı (derece)
VIRTUAL_VIEW_FOV=80.0

# ── 7. Adım 03: Araç Segmentasyonu (SAM 2) ──
SAM_CHECKPOINT_PATH=./checkpoints/sam2_hiera_large.pt
SAM_MODEL_CFG=sam2_hiera_l.yaml
# Kare alanında aracın kaplaması gereken minimum oran (0.0 - 1.0)
MIN_MASK_AREA_RATIO=0.05

# ── 8. Adım 04: Kamera Poz Tahmini (COLMAP / GLOMAP) ──
COLMAP_BIN=colmap
# Görüntülerin en az yüzde kaçının sparse modele başarıyla kayıt olması gerektiği (0.0 - 1.0)
MIN_REGISTRATION_RATE=0.70
# İleride eklenecek feed-forward tahminciler için yedek kanca ("none", "vggt", "mast3r")
POSE_FALLBACK_ESTIMATOR=none

# ── 9. Adım 05: 3B Rekonstrüksiyon (Nerfstudio / Gaussian Splatting) ──
# Seçenekler: "splatfacto" veya "2dgs"
RECON_METHOD=2dgs
TRAIN_ITERATIONS=15000
DEVICE=cuda
MIN_PSNR=20.0

# ── 10. Adım 06: Mesh Çıkarma, Hizalama ve Ölçekleme (Extract Mesh) ──
MESH_TARGET_FACES=50000
TSDF_VOXEL_LENGTH=0.015
TSDF_SDF_TRUNC=0.06
RANSAC_GROUND_DIST_THRESHOLD=0.02
# Bilinen gerçek ölçek referansı (metre/birim, 0.0 ise otomatik/normalize hesaplanır)
KNOWN_METERS_PER_UNIT=0.0

# ── 11. Adım 07: UV Açma ve Doku Fırınlama (Texture) ──
TEXTURE_SIZE=2048

# ── 12. Adım 09: Dışa Aktarım (Export) ──
# Virgülle ayrılmış format listesi: glb (zorunlu), usdz (opsiyonel)
EXPORT_FORMATS=glb

# ── 13. Geliştirme ve Günlükleme (Logging) ──
# true olduğunda GPU veya ağır modeller olmadan tüm adımlar uçtan uca geçerli test artefaktları üretir
DEV_MOCK_MODE=false
LOG_LEVEL=INFO
